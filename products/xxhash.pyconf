default :
{
    name : "xxhash"
    build_source : "script"
    compil_script :  'pip_install' + $VARS.scriptExtension
    get_source : "archive"
    patches : []
    system_info :
    {
        rpm : []
        rpm_dev : ['python3-xxhash']
        apt : []
        apt_dev : ['python3-xxhash']
    }
    environ :
    {
       env_script : "xxhash.py"
    }
    depend : ['Python','setuptools']
    opt_depend: []
    source_dir : $APPLICATION.workdir + $VARS.sep + 'SOURCES' + $VARS.sep + $name
    build_dir : $APPLICATION.workdir + $VARS.sep + 'BUILD' + $VARS.sep + $name
    install_dir : 'base'
    properties :
    {
      incremental : "yes"
      pip : "yes"
    }
}